# Velk — environment variables
# Copy this file to `.env` and edit. The `.env` file is gitignored.

# ---------- App ----------
APP_NAME="Velk"
# Origin ONLY — scheme + host, e.g. "https://example.com". Do NOT include a
# subdirectory here, even on a subdirectory install — that's APP_BASE_PATH
# below. Velk always composes the two itself (APP_URL + APP_BASE_PATH +
# path); putting the subdirectory in APP_URL too doubles it. Leave empty in
# local dev to fall back to the current request's own scheme + host.
APP_URL=""
# true only for local dev — leaks stack traces (paths, queries, versions) to
# visitors in production. Flip to true temporarily while debugging locally.
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo

# Set when Velk is mounted at a subdirectory (e.g. http://example.com/velk/).
# Leave empty to autodetect from SCRIPT_NAME. Never include this in APP_URL
# above — see the note there.
# APP_BASE_PATH=/velk

# ---------- Database ----------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=velk
DB_USERNAME=root
DB_PASSWORD=""

# ---------- First-run install ----------
# Used the FIRST time Velk boots against this database. The installer creates
# the DB (if missing), runs migrations, syncs pages from site.json, and creates
# this admin user. Once a user exists, these are ignored — feel free to remove
# them after first login.
INITIAL_USER_EMAIL=""
INITIAL_USER_PASSWORD=""
INITIAL_USER_NAME="Admin"

# ---------- Session ----------
# Cache de borda (CDN/Cloudflare). Segundos que o EDGE pode guardar uma
# resposta anônima. Vazio ou 0 = desligado, e é o padrão: nada muda.
#
# Só respostas que NÃO abriram sessão recebem este cabeçalho. Página com
# formulário abre sessão para gerar o token CSRF, então nunca é cacheada —
# token é segredo por visitante e página cacheada é a mesma para todos.
#
# Emite `s-maxage`, não `max-age`: a borda guarda, o navegador revalida. Um
# `max-age` alto faria o visitante ver conteúdo velho até o cache DELE
# expirar, o que numa correção urgente é o pior comportamento possível.
#
# Com APP_DEBUG=true sai também um `X-Velk-Cache` dizendo se a resposta é
# cacheável ou por que não — é assim que se descobre um `csrf_field()` num
# partial global, que faria TODA página gravar sessão e nada cachear.
# Não combine com o modo strict da CSP (security.csp no site.json; ver
# AGENTS.md): a página em cache entrega a mesma senha (nonce) a todo visitante.
CACHE_TTL=0

SESSION_NAME=velk_session
# How long a login lasts without use, in seconds, counted from the LAST use
# (not from sign-in): each panel screen renews the admin's; any page that
# reads the member's login renews the member's. Past the limit, only that
# login drops — admin and member share one session. No "remember me".
# Admin: 2 days. Member: 30 days.
ADMIN_SESSION_LIFETIME=172800
MEMBER_SESSION_LIFETIME=2592000
# Where session data lives. Default: storage/sessions, created on demand
# (0700) — out of reach of the host's cleanup cron (Debian's `sessionclean`
# reads php.ini's 24-minute gc_maxlifetime and would log admins out) and of
# the other sites on the server. Data and cookie last the longer of the two
# limits above, renewed on each use.
# Leave empty to use php.ini's session.save_path instead. Only applies to the
# "files" handler: a php.ini that stores sessions in Redis/Memcached is kept.
# SESSION_PATH=

# ---------- Admin ----------
# ADMIN_PREFIX=/admin

# Default admin-panel language (pre-login screens + users with no preference).
# English-first: fresh installs default to English. Set to pt / es as needed.
# Also governs the language of member (site-visitor) login-code emails —
# those always use this default (members have no locale preference of their
# own), so PT installs should set ADMIN_LOCALE=pt on upgrade.
ADMIN_LOCALE=en

# ---------- SMTP (optional) ----------
# Used for outgoing email (password resets, etc).
# When empty, Velk falls back to PHP's mail() which only works on servers with sendmail configured.
# Port 465 = implicit SSL, port 587 = STARTTLS.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Velk <noreply@example.com>"

# ---------- Stripe (assinaturas de membros) ----------
# Chaves do dashboard do Stripe (use as de TEST durante o desenvolvimento).
# A feature de assinatura só liga quando STRIPE_SECRET_KEY está presente
# E há planos declarados em site.json → members.plans.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Opcional (só faria falta num futuro checkout via Elements):
STRIPE_PUBLISHABLE_KEY=""
# Secret do webhook da LOJA (endpoint separado /store/stripe-webhook).
# Use a mesma STRIPE_SECRET_KEY; este é o secret do 2º webhook do Stripe.
STRIPE_STORE_WEBHOOK_SECRET=""

# ── Proteção anti-bot dos formulários (opcional) ──────────────────────
# Cloudflare Turnstile. Preencha as DUAS chaves para ativar; deixe vazias
# e os formulários seguem só com honeypot + CSRF, como sempre foram.
#
# Chaves em dash.cloudflare.com → Turnstile → Adicionar widget. O domínio
# NÃO precisa usar o DNS da Cloudflare — basta cadastrar o hostname no
# widget. Escolha ali também o modo (Managed / Non-interactive / Invisible);
# o Velk não tem opção pra isso, quem decide é o painel da Cloudflare.
#
# O tema precisa imprimir <?= form_captcha() ?> dentro do <form>.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Política de segurança de conteúdo (CSP) do site público ──────────
# A política (o modo e as listas de domínios) mora no site.json do tema, em
# security.csp — ver AGENTS.md. Daqui vem só o coletor de relatos, que muda
# por ambiente: uma URL https:// que recebe os relatos de violação nos modos
# strict e report.
# Até a v3.8.3 a política vinha daqui (CSP_MODE, CSP_FRAME_SRC…). Essas
# variáveis não são mais lidas; enquanto uma estiver definida com valor
# diferente do padrão antigo, o log do PHP avisa.
CSP_REPORT_URI=""

# Auto-aplicar migrations pendentes no primeiro acesso web após um upgrade
# (útil em hospedagem sem shell). Ligado por padrão. Para gerenciar migrations
# só manualmente (via `bin/velk migrate`), use AUTO_MIGRATE=false.
AUTO_MIGRATE=true

# ── Upload de arquivos grandes (vídeo) ───────────────────────────────
# O limite efetivo de upload é o MENOR entre o teto do PHP e o da
# aplicação por categoria (imagens/docs 25 MB · áudio 50 MB · zip 100 MB
# · vídeo 200 MB). Os defaults do PHP (2M/8M) bloqueiam vídeo — ajuste
# no php.ini / painel da hospedagem:
#   upload_max_filesize = 200M
#   post_max_size = 210M
# (Não é variável de .env — é configuração do PHP do servidor.)
