/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/form-uploads/*
!/storage/form-uploads/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
# Session data (one file per session, named by its id). Created on demand,
# 0700, by the PHP that serves the site — never committed, never shipped.
/storage/sessions/

# Theme — project-specific, not part of Velk core.
# Each project clones its own theme repo into `theme/`:
#   git clone https://github.com/your-org/your-theme.git theme
/theme/

# Per-project files — Velk ships `.example` versions; live versions are
# gitignored so projects can customize them (custom redirects, security
# headers, crawler rules, server-specific tuning) without future Velk
# updates overwriting their changes. The `.example` files (.htaccess.example,
# nginx.conf.example, robots.txt.example) remain versioned as templates.
/.htaccess
/nginx.conf
/robots.txt

# Environment — local secrets, never commit
.env
.env.local
/config/env.local.php

# Deploy config — SSH credentials and DB password for remote.
# Created by the Velk SSH deploy/download/content workflows.
/.deploy/

# Editor / tooling per-machine settings
.DS_Store
.idea/
.vscode/
.claude/
*.log

# Claude planning artifacts — brainstorming specs + implementation plans
# generated by the superpowers skills. Not part of the CMS core; kept local only.
/docs/superpowers/

# Subagent-driven-development scratch (task briefs, review diffs, progress ledger).
/.superpowers/

# Release publishing — R2 credentials (bin/release) and local build artifacts.
.release.env
/dist/
